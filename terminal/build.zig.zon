.{
    .name = .tars_terminal,
    .version = "0.0.0",
    .fingerprint = 0x3a4ce1d146c5abb9,
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        .ghostty = .{ .path = "ghostty-src" },
        // ZU-M1: `@cImport` 대신 C 헤더를 번역한다. ZU-M2: ghostty가 0.17에서 쓰는
        // 판과 같다 — ghostty는 `pkg/translate-c`(wrapper)를 거쳐 이 패키지를 받고,
        // 우리는 wrapper 없이 바로 받는다(`build.zig`의 `translateC`가 그 역할이다).
        .translate_c = .{
            .url = "https://deps.files.ghostty.org/translate_c-02ff0c523fb92a38939b04d0145c4a9602a74d56.tar.gz",
            .hash = "translate_c-2.0.0-Q_BUWltOBwBYABF84EUL208pIFeUIwbBs29FmVBaafN5",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "vendor",
    },
}
