#!/bin/sh
# 감독 목록의 dbus 칸(BT design 결정 4). init이 이 스크립트를 띄우고, 이 스크립트는
# 소켓 자리를 만든 뒤 dbus-daemon을 exec한다 — exec이라서 PID 1이 쥔 pid가 곧
# dbus-daemon이다(tars-wifi와 같은 이유).
#
# 시스템 버스 하나다. 지금 손님은 bluetoothd와 bluetoothctl뿐이지만 설정
# (/usr/share/dbus-1/system.conf · system.d/*.conf)은 Debian 패키지 것을 그대로 쓴다 —
# 정책 파일을 우리가 짓지 않는다. --nofork · --nopidfile은 감독자가 pid를 쥐고 있으니
# 데몬이 스스로 떨어져 나가지 않게 하는 것이다.
#
# 소켓은 /run/dbus/system_bus_socket이다(system.conf의 기본값). /run은 initramfs의
# 디렉터리라 부팅마다 비어 있다 — 그래서 여기서 만든다. 커널에 INOTIFY_USER가 없어
# dbus-daemon이 "Cannot initialize inotify"를 한 줄 적는다(설정 디렉터리 감시를 포기할
# 뿐이다, BT-M0 실측 5). machine-id는 없어도 뜬다(같은 실측).
#
# tars-bluetoothd가 이 소켓이 생길 때까지 기다린다 — 두 칸이 같은 바퀴에 뜬다.
mkdir -p /run/dbus
# bluetooth 체인이 이 줄을 grep한다.
echo "tars-dbus: system bus on /run/dbus/system_bus_socket" >&2
exec /usr/bin/dbus-daemon --system --nofork --nopidfile
