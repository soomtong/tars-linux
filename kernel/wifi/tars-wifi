#!/bin/sh
# 감독 목록의 wpa_supplicant 칸(WL design 결정 4). init이 이 스크립트를 띄우고,
# 이 스크립트는 지금 있는 무선 인터페이스로 argv를 지어 wpa_supplicant를 exec한다.
# exec이라서 PID 1이 쥔 pid가 곧 wpa_supplicant다 — 그룹 SIGTERM도
# `tars-service`도 wpa_supplicant에 곧바로 닿는다.
#
# argv를 init이 못 짓는 이유: 인터페이스가 부팅마다 · 재시작마다 다르고,
# Debian의 wpa_supplicant에는 이름 패턴으로 고르는 `-M`이 없다(실측 5).
# 재시작될 때마다 다시 세므로 그때 있던 인터페이스를 잃지 않는다.
#
# 여기서 세지 못한 것 — 이 스크립트가 뜬 뒤에 생긴 인터페이스(firmware를 늦게
# 올리는 칩, 부팅 뒤 꽂은 동글) — 은 dhcpcd의 hook `10-tars-wifi`가
# `interface_add`로 넣는다(실측 7).
#
# 무선인지는 `phy80211` 링크로 가른다. 라디오가 0개여도 생기는 `hwsim0`은
# radiotap 장치라 이 링크가 없다(실측 2).
#
# 세 경로가 init/src/wifi.zig · 10-tars-wifi와 같은 글자여야 한다.
conf=/config/wpa_supplicant.conf
global=/run/wpa_supplicant/global

# -g: 전역 소켓. hook이 여기로 interface_add를 보낸다.
# -O: 인터페이스별 소켓의 자리. 사람의 파일에 ctrl_interface 줄이 없어도
#     `wpa_cli`가 닿는다.
set -- /usr/bin/wpa_supplicant -g "$global" -O /run/wpa_supplicant
names=""
for dev in /sys/class/net/*; do
  [ -e "$dev/phy80211" ] || continue
  # 둘째부터는 -N으로 새 인터페이스의 기술을 연다.
  [ -n "$names" ] && set -- "$@" -N
  set -- "$@" -c "$conf" -i "${dev##*/}"
  names="$names ${dev##*/}"
done

mkdir -p /run/wpa_supplicant
# wifi 체인이 이 줄을 grep한다.
echo "tars-wifi: wpa_supplicant on${names:- no interface yet}" >&2
exec "$@"
